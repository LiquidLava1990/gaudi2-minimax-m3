# MiniMax-M3 fp8-static — LAZY + HPU-GRAPHS test (M3 currently runs torch.compile / is_lazy=False,
# which Habana docs list as "not fully supported with FP8/INC quantization"). This forces the
# lazy+HPU-graph path GLM uses. RISK: the route-b grouped fp8 op loads an is_lazy branch
# (libmoe_fused_grouped_fp8.so was the is_lazy=False path) — a lazy .so may be absent -> may fail
# to load/compile. GATE HARD on coherence before trusting any tok/s. Launch:
#   USE_M3=1 ./serve.sh minimax-m3-fp8-static-lazy
# A/B target: beat torch.compile M3 SS 10.2 and c128 405.
# =================================================================================================
MODEL_PATH=MiniMax-M3-fp8-experts-AutoRound
SERVED_NAME=minimax-m3
IMAGE=vllm-gaudi:next
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root -v $HOME/AI/hpu-moe-ext/hpu_moe_ext/fused_monolithic_moe_fp8.py:/opt/hpu-moe-ext/hpu_moe_ext/fused_monolithic_moe_fp8.py -v $HOME/AI/hpu-moe-ext/tpc_kernel/opbackend/build/libmoe_fused_monolithic_fp8_lazy.so:/opt/hpu-moe-ext/tpc_kernel/opbackend/build/libmoe_fused_monolithic_fp8_lazy.so -v $HOME/AI/vllm-gaudi-patch/worker/hpu_model_runner.py:/opt/vllm-gaudi/vllm_gaudi/v1/worker/hpu_model_runner.py"
# ADDED vs minimax-m3-fp8-static.env: PT_HPU_LAZY_MODE=1 + PT_HPU_ENABLE_LAZY_COLLECTIVES=true
MODEL_ENV="-e PT_HPU_LAZY_MODE=1 -e PT_HPU_ENABLE_LAZY_COLLECTIVES=true -e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_FP8_STATIC=1 -e M3_SWIGLUOAI=1 -e M3_FP8_SWIGLU_ROUTE=b -e VLLM_HPU_FORCE_CHANNEL_FP8=true -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true -e VLLM_HPU_LOG_STEP_GRAPH_COMPILATION=true"
VLLM_ARGS="--quantization compressed-tensors --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 128 --gpu-memory-utilization 0.9 --max-model-len 4096 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
