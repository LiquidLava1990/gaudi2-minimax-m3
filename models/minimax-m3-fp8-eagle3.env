# MiniMax-M3 — STATIC fp8 routed-expert base + the from-scratch MLP MTP draft head (eagle spec path).
# =====================================================================================================
# Combines the VALIDATED fp8-static base (minimax-m3-fp8-static.env: route-b swigluoai fp8 experts) with
# the from-scratch Medusa/MLP draft head (head_factory/m3/eagle_ckpt, FactoryEagleForCausalLM) served via
# the eagle spec-decode path. The int4 base the head was first measured on (56% single / 66% conc accept,
# MTP_RESULTS.md) is DELETED — only the fp8 checkpoint remains — so this re-measures the head's acceptance
# on TOP of the fp8 route-b base.
#
# Launch:  USE_M3=1 ./serve.sh minimax-m3-fp8-eagle
#   USE_M3=1 mounts + installs /opt/hpu-m3-ext (the M3 arch reg + m3_fp8_static_patch, gated M3_FP8_STATIC=1).
#   HPU_EAGLE_HEAD triggers hpu_moe_ext/__init__.py:486 factory_eagle.register() -> FactoryEagleForCausalLM.
#
# MOUNTS (modeled on the COMPLETE glm52-eagle.env mount set — the stale minimax-m3-eagle.env was MISSING the
# proposer mount): worker (eagle/async-spec runner) + input_batch + platform (auto-downgrades async under
# spec unless HPU_ASYNC_SPEC=1) + head_factory(/opt/hf) + hpu_eagle_factoryeagle.py OVER the in-image
# hpu_eagle.py (the patched runner does `from ...hpu_eagle import HpuEagleProposer`; the factoryeagle file
# IS that canonical proposer with the eagle3 isinstance assert relaxed — method=eagle uses the base path).
# =====================================================================================================
IMAGE=vllm-gaudi:next
MODEL_PATH=MiniMax-M3-fp8-experts-AutoRound
SERVED_NAME=minimax-m3
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root -v $HOME/AI/head_factory:/opt/hf -v $HOME/AI/vllm-gaudi-patch/worker/hpu_model_runner.py:/opt/vllm-gaudi/vllm_gaudi/v1/worker/hpu_model_runner.py -v $HOME/AI/vllm-gaudi-patch/worker/hpu_input_batch.py:/opt/vllm-gaudi/vllm_gaudi/v1/worker/hpu_input_batch.py -v $HOME/AI/vllm-gaudi-patch/platform/platform.py:/opt/vllm-gaudi/vllm_gaudi/platform.py -v $HOME/AI/vllm-gaudi-patch/v1/spec_decode/hpu_eagle_factoryeagle.py:/opt/vllm-gaudi/vllm_gaudi/v1/spec_decode/hpu_eagle.py -v $HOME/AI/hpu-moe-ext/hpu_moe_ext/fused_monolithic_moe_fp8.py:/opt/hpu-moe-ext/hpu_moe_ext/fused_monolithic_moe_fp8.py -v $HOME/AI/hpu-moe-ext/tpc_kernel/opbackend/build/libmoe_fused_monolithic_fp8_lazy.so:/opt/hpu-moe-ext/tpc_kernel/opbackend/build/libmoe_fused_monolithic_fp8_lazy.so"
# fp8-static base env (NO M3_EXPERT_RUNTIME — checkpoint is already fp8 on disk) + the eagle head trigger.
MODEL_ENV="-e HPU_EAGLE_HEAD=/opt/hf/factory -e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_FP8_STATIC=1 -e M3_EAGLE3=1 -e M3_SWIGLUOAI=1 -e M3_FP8_SWIGLU_ROUTE=b -e VLLM_HPU_FORCE_CHANNEL_FP8=true -e VLLM_DECODE_BS_BUCKET_MIN=1 -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
# --quantization compressed-tensors (the on-disk float-quantized experts) + fp8 KV. max-num-seqs 32 to
# leave a real concurrency-sweep range while keeping spec warmup (verify bs = 2*bs) bounded. eagle head =
# method=eagle, num_speculative_tokens=1 (the M3 MLP head is single-depth, use_attn:false).
VLLM_ARGS="--quantization compressed-tensors --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 32 --gpu-memory-utilization 0.9 --max-model-len 4096 --async-scheduling --no-enable-prefix-caching --trust-remote-code --speculative-config '{\"method\":\"eagle3\",\"model\":\"/opt/hf/m3/eagle_ckpt\",\"num_speculative_tokens\":1}'"
