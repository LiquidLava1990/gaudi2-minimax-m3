# MiniMax-M3 (GQA, H_kv=4, head_dim=128) — TurboQuant sub-fp8 KV: k8v4 = fp8-K + int4-V (WHT).
# ===================================================================================================
# This is the minimax-m3-int4.env serve (int4 experts, dense-GQA, coherence-first) but with the KV
# cache switched from fp8_inc -> the BUILT TurboQuant k8v4 kernel (hpu-kvq-ext), for ~1.33x more KV
# capacity (fp8 K + int4 V; ~46 vs ~61 KB/tok). M3 is the PRIME GQA target (120 KB/tok raw). GLM
# (MLA) must NEVER use this — the platform gate refuses turboquant for MLA models (fp8_inc stays).
#
# ⚠️ FIRST-DRAFT WIRE — run the on-card OP-PARITY gate FIRST (oncard_op_test.sh), then this smoke.
#   Coherence must be checked vs the fp8_inc control (models/minimax-m3-int4.env). See the report for
#   the exact spots most likely to need on-card fixes (grouping/merge of the custom spec, the
#   torch.compile graph-break at the KV write/read, contiguous-PA fetch, block-swap/preemption).
#
# Launch:   USE_M3=1 ./serve.sh minimax-m3-turboquant
#   (USE_KVQ=1 is set BELOW so serve.sh mounts + `pip install -e /opt/hpu-kvq-ext` and mounts the .so
#    tree at /opt/turboquant_kv. USE_M3=1 still mounts+installs the M3 model class, as in the int4 env.)
# ===================================================================================================
#
# --- checkpoint (already under MODELS_DIR=/mnt/fastmodels, mounted at /models:ro by serve.sh) -------
MODEL_PATH=MiniMax-M3-int4-experts-AutoRound
SERVED_NAME=minimax-m3
IMAGE=vllm-gaudi:next
#
# --- plugin overlays: M3 model class (USE_M3) + TurboQuant KV kernel (USE_KVQ) ----------------------
# USE_KVQ=1 -> serve.sh bind-mounts hpu-kvq-ext -> /opt/hpu-kvq-ext (pip install -e) AND
#             mmel/turboquant_kv -> /opt/turboquant_kv (holds kernel-kv/build/*.so). The plugin's
#             entry-point "06.hpu_kvq_ext" runs register() at engine init.
USE_KVQ=1
# minimax-m3/vllm holds minimax_m3.py + platform_patch_msa.py; minimax-m3 holds the int4 runtime patch.
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root"
#
# --- env (docker -e flags) -------------------------------------------------------------------------
# HPU_KVQ_READY=1  : the explicit opt-in that flips platform_patch_kvq.KVQ_READY True (after the ops
#                    load + the cache/attn wiring installs). WITHOUT it the plugin is fully inert and
#                    --kv-cache-dtype turboquant_k8v4 is REFUSED (serve would error loudly) -> so it
#                    MUST be set for this env. Mirrors HPU_DSA_READY.
# HPU_KVQ_SO_DIR   : where the compiled .so live inside the container (the USE_KVQ mount).
# The M3_* / fork / timeout flags are inherited verbatim from minimax-m3-int4.env (unchanged).
MODEL_ENV="-e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_EXPERT_RUNTIME=int4 -e M3_SWIGLUOAI=1 -e HPU_KVQ_READY=1 -e HPU_KVQ_SO_DIR=/opt/turboquant_kv/kernel-kv/build -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
#
# --- vLLM serve flags ------------------------------------------------------------------------------
# --kv-cache-dtype turboquant_k8v4 : the BUILT TurboQuant kernel (fp8 K + int4 V + WHT). The ONLY
#   change vs minimax-m3-int4.env's `fp8_inc`. --gpu-memory-utilization 0.85 (conservative for the
#   first draft; the KV pool should size to ~1.33x more tokens than fp8 — read the startup mem report).
# --max-num-seqs 16 : conservative first bring-up (raise after coherence + parity pass).
VLLM_ARGS="--kv-cache-dtype turboquant_k8v4 --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 16 --gpu-memory-utilization 0.85 --max-model-len 8192 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
