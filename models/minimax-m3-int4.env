# MiniMax-M3 (MiniMaxM3SparseForConditionalGeneration) — INT4 dense-GQA bring-up on 8x Gaudi 2.
# ===================================================================================================
# This is the INT4 path (the AutoRound int4-experts checkpoint), DISTINCT from models/minimax-m3.env
# (which is the bf16 + INC-fp8 phase-1 path — a different effort needing an on-card INC MEASURE pass
# whose QUANT_CONFIG json does not exist yet). Goal: the FIRST WORKING M3 — coherent text in
# DENSE-GQA fallback (MSA sparse OFF), int4 experts, fp8_inc KV. Coherence/correctness first.
#
# Launch:   USE_M3=1 ./serve.sh minimax-m3-int4
#   (USE_M3=1 makes serve.sh mount + `pip install -e /opt/hpu-m3-ext`, exactly like USE_DSA does for
#    hpu-dsa-ext. hpu-m3-ext's vllm.general_plugins entry point "05.hpu_m3_ext" then, at engine init:
#      - registers arch MiniMaxM3SparseForConditionalGeneration -> minimax_m3:HpuMiniMaxM3ForConditionalGeneration
#      - applies platform_patch_msa.apply()  [INERT in dense phase; MSA_READY=False, no sparse signaled]
#      - calls m3_expert_runtime_patch.register()  [NO-OP at M3_EXPERT_RUNTIME=int4]
#    The model class + patches are MOUNTED from $HOME/AI/minimax-m3 (EXTRA_MOUNTS below); the
#    pinned image is NOT mutated.)
# ===================================================================================================
#
# --- checkpoint (already under MODELS_DIR=/mnt/fastmodels, mounted at /models:ro by serve.sh) -------
MODEL_PATH=MiniMax-M3-int4-experts-AutoRound
SERVED_NAME=minimax-m3
IMAGE=vllm-gaudi:next
# :next carries the hpu-moe-ext int4 stack the GLM-5.1 int4 serve validated (MoeWNA16HPUMethod,
# MTP/sampler patches). NOT :1.24 (double-registers habana_bernoulli with the mounted .so).
#
# --- mounts: the M3 model class + patches + the registration plugin --------------------------------
# minimax-m3/vllm holds minimax_m3.py + platform_patch_msa.py (-> /opt/m3-vllm, on sys.path).
# minimax-m3      holds m3_expert_runtime_patch.py + int4_to_fp8_load.py (-> /opt/m3-root, on sys.path).
# hpu-m3-ext is mounted+installed by serve.sh's USE_M3 hook (mirrors hpu-dsa-ext).
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root"
#
# --- env (docker -e flags) -------------------------------------------------------------------------
# M3_VLLM_DIR / M3_ROOT_DIR : where hpu-m3-ext finds the mounted M3 sources (put on sys.path).
# M3_EXPERT_RUNTIME=int4    : the existing hpu-moe-ext int4->bf16 fused MoE (max KV room). int4 is the
#                             default; set explicitly for clarity. (=fp8 would int4->fp8 at load.)
# HPU_MSA_READY is INTENTIONALLY ABSENT (== OFF) -> dense-GQA fallback (sparse layers run genuine
#   dense GQA; never a half-wired sparse consume). DO NOT add it until the MSA wire is on-card-validated.
# fp8_inc KV WITHOUT --quantization inc / QUANT_CONFIG: the HPU attention backend enables a
#   self-scaling fp8 KV path (enable_fp8_attn = kv_cache_dtype=='fp8_inc' AND QUANT_CONFIG is None).
#   So we deliberately set NEITHER --quantization nor QUANT_CONFIG -> fp8 KV with no INC measurement
#   needed, and the model can run under torch.compile (the proven GLM int4 regime; INC would force lazy).
# Generous timeouts: a 428B int4 model's first graph-compile is MINUTES; do not trip the iter/RPC timeout.
# VLLM_WORKER_MULTIPROC_METHOD=fork : REQUIRED for this remote-code (trust_remote_code) checkpoint. The
#   config carries a dynamic `transformers_modules` class (auto_map -> configuration_minimax_m3_vl).
#   Under `spawn`, the engine/worker children re-pickle the VllmConfig into a FRESH interpreter that has
#   not loaded the remote module -> unpickle dies (transformers 5.10.2 surfaces it as
#   "_LazyConfigMapping.__init__() missing 1 required positional argument: 'mapping'", i.e. the remote
#   config's CONFIG_MAPPING reference can't be reconstructed). `fork` makes children INHERIT the parent's
#   already-registered remote module + config registry, so the config reconstructs cleanly. Proven
#   card-free: spawn-child unpickle FAILS, fork-style (pre-registered) unpickle OK. On HPU nothing in
#   _maybe_force_spawn legitimately requires spawn (not CUDA/XPU/Ray/NUMA/WSL), so forcing fork is safe.
# M3_SWIGLUOAI=1 : PRIORITY-1 fix — serve the routed int4 experts with the EXACT gpt-oss-style
#   swigluoai gate (gate.clamp(max=7)*sigmoid(1.702*gate) * (up.clamp(-7,7)+1)) via an UNFUSED
#   per-expert dequant->GEMM path, instead of hpu-moe-ext's silu-only mixture_of_experts intrinsic.
#   REQUIRED for coherent M3: transformers overrides hidden_act->"silu", so the plugin can NOT
#   detect swigluoai from the act string; this explicit flag is the trigger. Without it the routed
#   experts run plain SiLU = incoherent. (Single-token decode is swigluoai-correct; prefill T>1 falls
#   to the stock silu intrinsic with a one-shot warning — fine for the greedy-decode coherence test.)
# M3_SWIGLUOAI_VERIFY=1 : EAGER-ONLY first-call proof that the unfused dequant/GEMM/orientation is
#   bit-exact vs the stock silu intrinsic (the .item() breaks lazy capture; leave OFF for the lazy serve).
MODEL_ENV="-e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_EXPERT_RUNTIME=int4 -e M3_SWIGLUOAI=1 -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
#
# --- vLLM serve flags ------------------------------------------------------------------------------
# int4 experts autodetect via hpu-moe-ext (NO --quantization flag, exactly like the GLM int4 serve).
# --kv-cache-dtype fp8_inc : fp8 KV (the only HPU non-default KV dtype); self-scaled here (no INC json).
# --tensor-parallel-size 8 --enable-expert-parallel : 128 experts across 8 cards.
# --max-num-seqs 16 : conservative for first bring-up of a 428B int4 model (raise after it's stable).
# --max-model-len 8192 : phase-1 dense context (the 1M target needs the MSA kernel).
# --block-size 128 (HPU), --gpu-memory-utilization 0.9, --async-scheduling, --no-enable-prefix-caching,
# --trust-remote-code (config auto_map -> remote configuration_minimax_m3_vl).
VLLM_ARGS="--kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 16 --gpu-memory-utilization 0.9 --max-model-len 8192 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
