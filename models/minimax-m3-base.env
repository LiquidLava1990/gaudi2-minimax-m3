# M3 int4 BASE (NO spec-decode) — identical serve config to minimax-m3-eagle.env minus the draft, so a
# single-stream/concurrency measurement here is the apples-to-apples baseline that isolates the EAGLE draft's
# per-step overhead (embed + 200K-vocab lm_head all-gather) from the box's sync/fabric floor.
IMAGE=vllm-gaudi:next
MODEL_PATH=MiniMax-M3-int4-experts-AutoRound
SERVED_NAME=minimax-m3
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root"
MODEL_ENV="-e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_EXPERT_RUNTIME=int4 -e M3_SWIGLUOAI=1 -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 16 --gpu-memory-utilization 0.9 --max-model-len 8192 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
