# MiniMax-M3 (MiniMaxM3SparseForConditionalGeneration) — FP8-RUNTIME experts, dense-GQA, 8x Gaudi 2.
# ===================================================================================================
# SAME on-disk int4 AutoRound checkpoint as minimax-m3-int4.env (MODEL_PATH below is identical), but
# the experts are converted int4 -> fp8(E4M3) PER-CHANNEL at LOAD and served with NATIVE fp8 matmuls
# (no per-token int4->bf16 dequant). This is the CONCURRENCY play: fp8 is Gaudi-2's first-class low-
# precision MME, so under load the expert GEMMs run native fp8 instead of the int4 path's per-token
# convert_from_uint4 (the measured ~98%-of-decode tax that does NOT amortize at concurrency).
#
#   single-stream : fp8 is NOT expected to beat int4 much — decode is host-sync-bound (~4-8 tok/s),
#                   not expert-compute-bound, at batch=1. The win is at CONCURRENCY (c=10/30/50).
#   concurrency   : fp8 native MME removes the per-token dequant -> the expert stage stops being the
#                   serializing cost, so aggregate throughput should rise vs int4. MEASURE on-card.
#
# Launch (dedicated env):   USE_M3=1 M3_SWIGLUOAI=1 ./serve.sh minimax-m3-fp8
#   (USE_M3=1 mounts + installs hpu-m3-ext; M3_EXPERT_RUNTIME=fp8 is baked into MODEL_ENV below, so it
#    need not be on the command line — but `USE_M3=1 M3_SWIGLUOAI=1 M3_EXPERT_RUNTIME=fp8 ./serve.sh
#    minimax-m3-fp8` is equivalent and harmless. M3_SWIGLUOAI=1 is REQUIRED — see below.)
# Equivalent WITHOUT a new env file (override the int4 env in place):
#   MODEL_ENV_EXTRA="-e M3_EXPERT_RUNTIME=fp8 -e VLLM_HPU_FORCE_CHANNEL_FP8=true" \
#     USE_M3=1 M3_SWIGLUOAI=1 ./serve.sh minimax-m3-int4
#   (serve.sh appends MODEL_ENV_EXTRA after MODEL_ENV, and a later docker -e wins -> flips int4->fp8.)
# ===================================================================================================
#
# --- checkpoint (SAME int4 artifact; only the HBM staging differs) ---------------------------------
MODEL_PATH=MiniMax-M3-int4-experts-AutoRound
SERVED_NAME=minimax-m3
IMAGE=vllm-gaudi:next
# :next carries the hpu-moe-ext int4 stack (MoeWNA16HPUMethod) this fp8 path REFINES at load, plus the
# native VllmMixtureOfExpertsOpFP8PerChannel in vllm_gaudi.extension.ops. NOT :1.24.
#
# --- mounts: the M3 model class + patches + the registration plugin (identical to the int4 env) -----
# minimax-m3/vllm -> /opt/m3-vllm (minimax_m3.py + platform_patch_msa.py).
# minimax-m3      -> /opt/m3-root (m3_expert_runtime_patch.py + int4_to_fp8_load.py — the fp8 transform).
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root"
#
# --- env (docker -e flags) -------------------------------------------------------------------------
# M3_EXPERT_RUNTIME=fp8  : THE SWITCH. m3_expert_runtime_patch wraps MoeWNA16HPUMethod so
#   process_weights_after_loading runs the int4 repack VERBATIM, then int4->fp8-per-channel transforms
#   every routed expert (int4_to_fp8_load.stage_layer_int4_to_fp8), frees the int4 tensors, and swaps
#   layer.moe_op to VllmMixtureOfExpertsOpFP8PerChannel. apply_monolithic then drives the fp8 path.
# M3_SWIGLUOAI=1  : STILL REQUIRED. The fp8 op's native intrinsic is silu/gelu-only; M3 needs the
#   gpt-oss swigluoai gate. The swigluoai patch's apply_monolithic wrap detects the fp8-converted
#   layer (_m3_fp8_converted) and delegates to m3_expert_runtime_patch._apply_fp8_swigluoai, which runs
#   the UNFUSED fp8 swigluoai loop (route b): gather routed experts from the fp8 stacks, dequant
#   fp8->bf16 via the op's CHANNEL formula (ONE multiply, NOT int4's nibble-unpack), apply the EXACT
#   swigluoai (gate.clamp(max=7)*sigmoid(1.702*gate)*(up.clamp(-7,7)+1)), GEMM, weighted-combine.
#   Without M3_SWIGLUOAI=1 the fp8 layer would have no swigluoai handler -> LOUD refuse-to-serve (the
#   handoff RuntimeError in m3_swigluoai_patch). So M3_SWIGLUOAI=1 is mandatory in fp8 mode too.
# M3_FP8_SWIGLU_ROUTE=b  : the ROBUST unfused-fp8 swigluoai path (DEFAULT, correct on the eager-frontend
#   :next image). Route 'a' is the native bias_fp8_fused_weights gpt_swiglu kernel, which is
#   frontend_blocklist:[eager] on :next (-> slow CPU composite) AND is the same fused-swiglu family that
#   was BROKEN on the int4 side (perm=False->~0, perm=True->card hang). DO NOT use route a here unless
#   it is later proven live on a lazy frontend. Leave =b. (Explicit, though 'auto' also picks b.)
# VLLM_HPU_FORCE_CHANNEL_FP8=true : keep the NATIVE per-channel fp8 op family (the op our transform
#   stages into). Default-on in the image; set explicitly so a config drift can't pick a block-fp8 op.
# Everything else is IDENTICAL to minimax-m3-int4.env (TP=8, expert-parallel, fork, fp8_inc KV, the
# generous timeouts, dense-GQA fallback with HPU_MSA_READY intentionally absent).
MODEL_ENV="-e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_EXPERT_RUNTIME=fp8 -e M3_SWIGLUOAI=1 -e M3_FP8_SWIGLU_ROUTE=b -e VLLM_HPU_FORCE_CHANNEL_FP8=true -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
#
# --- vLLM serve flags ------------------------------------------------------------------------------
# HBM BUDGET (the one real difference from int4): fp8 experts are ~2x the int4 HBM. Whole-model HBM is
#   ~471 GiB in fp8 (~59 GiB/card across 8x Gaudi-2 96 GiB) vs ~226 GiB int4 (~28 GiB/card). At
#   --gpu-memory-utilization 0.9 (~86 GiB usable/card) that leaves ~27 GiB/card for KV+activations in
#   fp8 vs ~58 GiB int4 — still ample for --max-model-len 4096 dense, but LESS KV room than int4 (so
#   fp8 trades context/KV headroom for native-fp8 concurrency throughput, exactly the intended deal).
# --max-num-seqs 128 : RAISED vs int4's 16 — this env exists to measure CONCURRENCY (c=10/30/50), and
#   the fp8 expert stage no longer serializes on per-token dequant, so allow a wide batch. If a card
#   OOMs at load+KV, drop to 48/32 (fp8 weights are fixed; the slack is KV). The int4 env keeps 16.
# Rest identical to the int4 serve: NO --quantization flag (experts autodetect int4 via hpu-moe-ext,
#   THEN this patch converts them to fp8 at load), fp8_inc KV (self-scaled, no INC json), TP=8 +
#   --enable-expert-parallel (128 experts/8 cards), block-size 128, async-scheduling, no prefix cache,
#   trust-remote-code (config auto_map -> remote configuration_minimax_m3_vl), max-model-len 8192.
VLLM_ARGS="--kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 128 --gpu-memory-utilization 0.9 --max-model-len 4096 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
