# M3 + EAGLE MTP draft (from-scratch fp8 head served via the eagle spec path). Base = minimax-m3-int4 +
# the FactoryEagleForCausalLM draft (head_factory/m3/eagle_ckpt) registered via HPU_EAGLE_HEAD. SERVE-TEST.
IMAGE=vllm-gaudi:next
MODEL_PATH=MiniMax-M3-int4-experts-AutoRound
SERVED_NAME=minimax-m3
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root -v $HOME/AI/head_factory:/opt/hf -v $HOME/AI/vllm-gaudi-patch/worker/hpu_model_runner.py:/opt/vllm-gaudi/vllm_gaudi/v1/worker/hpu_model_runner.py -v $HOME/AI/vllm-gaudi-patch/worker/hpu_input_batch.py:/opt/vllm-gaudi/vllm_gaudi/v1/worker/hpu_input_batch.py -v $HOME/AI/vllm-gaudi-patch/platform/platform.py:/opt/vllm-gaudi/vllm_gaudi/platform.py"
MODEL_ENV="-e HPU_EAGLE_HEAD=/opt/hf/factory -e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_EXPERT_RUNTIME=int4 -e M3_SWIGLUOAI=1 -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 16 --gpu-memory-utilization 0.9 --max-model-len 8192 --async-scheduling --no-enable-prefix-caching --trust-remote-code --speculative-config '{\"method\":\"eagle\",\"model\":\"/opt/hf/m3/eagle_ckpt\",\"num_speculative_tokens\":1}'"
