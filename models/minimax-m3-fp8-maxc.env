# M3 fp8 route-b MAX-CONCURRENCY push (gameplan config sweep: ml=3072/util=0.94/decode-bucket=128 -> ~130-180
# @ c80-100). Same fp8 route-b as minimax-m3-fp8.env (89@c50, util 55% headroom) but tuned for KV room + bigger
# decode buckets to fill the cards. Storm may cap/noise the high-c numbers (fabric flap), measured honestly.
IMAGE=vllm-gaudi:next
MODEL_PATH=MiniMax-M3-int4-experts-AutoRound
SERVED_NAME=minimax-m3
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root"
MODEL_ENV="-e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_EXPERT_RUNTIME=fp8 -e M3_SWIGLUOAI=1 -e M3_FP8_SWIGLU_ROUTE=b -e VLLM_HPU_FORCE_CHANNEL_FP8=true -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_DECODE_BLOCK_BUCKET_MIN=128 -e VLLM_DECODE_BLOCK_BUCKET_STEP=128 -e VLLM_DECODE_BLOCK_BUCKET_MAX=2048 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 128 --gpu-memory-utilization 0.94 --max-model-len 3072 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
