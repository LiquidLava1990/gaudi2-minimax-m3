# MiniMax-M3 — STATIC on-disk fp8 routed experts, dense-GQA, 8x Gaudi 2.
# ===================================================================================================
# This serves a TRUE fp8 checkpoint (quant/quantize_m3_fp8.py output): the 128 routed experts are
# stored float8_e4m3fn + per-output-channel weight_scale ON DISK; everything else (attention, MSA
# index proj, router gate, shared expert, dense MLP 0-2, embeddings, lm_head, norms, vision, AND the
# 7 native MTP modules) is bf16. NO int4 artifact, NO int4->fp8 load-time transform.
#
# vs minimax-m3-fp8.env: that one loads the INT4 checkpoint and converts int4->fp8 per-channel AT LOAD
# (M3_EXPERT_RUNTIME=fp8). This one loads experts that are ALREADY fp8 on disk via --quantization, so
# there is no int4 on disk and no load-time unpack — the serve-time HBM execution is the SAME native
# VllmMixtureOfExpertsOpFP8PerChannel + UNFUSED swigluoai route-b in both. (See FP8_RIGHT_QUANT_PLAN.md.)
#
# Launch:   USE_M3=1 ./serve.sh minimax-m3-fp8-static
#   (USE_M3=1 mounts + `pip install -e /opt/hpu-m3-ext`. The plugin's _apply_fp8_static() then wraps
#    the fp8 MoE method — HPUFp8MoEMethod (--quantization fp8) OR HPUCompressedTensorsW8A8Fp8MoEMethod
#    (--quantization compressed-tensors) — so its process_weights builds the route-b stacks and its
#    apply_monolithic delegates the M3 routed experts to the swigluoai route-b instead of native silu.
#    GATED on M3_FP8_STATIC=1 below; inert for every other serve.)
# ===================================================================================================
#
# --- checkpoint (the static fp8 artifact on MODELS_DIR=/mnt/fastmodels) ----------------------------
MODEL_PATH=MiniMax-M3-fp8-experts-AutoRound
SERVED_NAME=minimax-m3
IMAGE=vllm-gaudi:next
# :next carries the native VllmMixtureOfExpertsOpFP8PerChannel + HPUFp8MoEMethod /
# HPUCompressedTensorsW8A8Fp8MoEMethod (vllm_gaudi.ops.hpu_fp8 / hpu_compressed_tensors). NOT :1.24.
#
# --- mounts: the M3 model class + patches + the registration plugin (same as the other M3 envs) -----
EXTRA_MOUNTS="-v $HOME/AI/minimax-m3/vllm:/opt/m3-vllm -v $HOME/AI/minimax-m3:/opt/m3-root -v $HOME/AI/hpu-moe-ext/hpu_moe_ext/fused_monolithic_moe_fp8.py:/opt/hpu-moe-ext/hpu_moe_ext/fused_monolithic_moe_fp8.py -v $HOME/AI/hpu-moe-ext/tpc_kernel/opbackend/build/libmoe_fused_monolithic_fp8_lazy.so:/opt/hpu-moe-ext/tpc_kernel/opbackend/build/libmoe_fused_monolithic_fp8_lazy.so -v $HOME/AI/vllm-gaudi-patch/worker/hpu_model_runner.py:/opt/vllm-gaudi/vllm_gaudi/v1/worker/hpu_model_runner.py -v $HOME/AI/_src/vllm_gaudi/extension/ops.py:/opt/vllm-gaudi/vllm_gaudi/extension/ops.py"
#
# --- env (docker -e flags) -------------------------------------------------------------------------
# M3_FP8_STATIC=1 : THE SWITCH. Activates hpu_m3_ext.m3_fp8_static_patch — wraps the fp8 MoE method so
#   the routed experts serve via the unfused swigluoai route-b (the native fp8 intrinsic is silu-only).
# M3_SWIGLUOAI=1  : keep set for parity/clarity (route-b applies swigluoai intrinsically; the int4
#   swigluoai wrap is inert here because the method is the fp8 one, not MoeWNA16HPUMethod).
# M3_FP8_SWIGLU_ROUTE=b : the robust unfused route (route a's native gpt_swiglu kernel is eager-blocked
#   on :next). Leave =b.
# NOTE: do NOT set M3_EXPERT_RUNTIME=fp8 here — that is the int4->fp8 LOAD transform for the int4
#   checkpoint; this checkpoint is already fp8 on disk (the transform would have no int4 to read).
# VLLM_HPU_FORCE_CHANNEL_FP8=true : per-channel fp8 op family (what our stacks + route-b consume).
# fork / generous timeouts / log fallbacks : identical to the other M3 envs (remote-code trust_remote_code
#   config needs fork; first fp8 graph compile is minutes).
MODEL_ENV="-e M3_VLLM_DIR=/opt/m3-vllm -e M3_ROOT_DIR=/opt/m3-root -e M3_FP8_STATIC=1 -e M3_SWIGLUOAI=1 -e M3_FP8_SWIGLU_ROUTE=b -e VLLM_HPU_FORCE_CHANNEL_FP8=true -e VLLM_WORKER_MULTIPROC_METHOD=fork -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true -e HPU_KVQ_READY=1 -e HPU_KVQ_BACKEND=torch -e VLLM_SKIP_WARMUP=true"
#
# --- vLLM serve flags ------------------------------------------------------------------------------
# --quantization compressed-tensors : quantize_m3_fp8.py emits compressed-tensors `float-quantized`
#   (quant_method="compressed-tensors", weight-only per-channel e4m3fnuz, NO input_scale) -> selects
#   HPUCompressedTensorsW8A8Fp8MoEMethod -> the SAME VllmMixtureOfExpertsOpFP8PerChannel + w13_list our
#   patch wraps (hpu_compressed_tensors.py:449). (If a future quant emits the vLLM-native `fp8`
#   quant_method instead, change to `--quantization fp8`; the plugin wraps BOTH method classes.)
#   >>> ON-CARD WATCH: if the loader logs "no scheme matched for experts" / loads experts as bf16, the
#   checkpoint's config_groups.targets `re:.*block_sparse_moe\.experts\..*` needs switching to
#   ["Linear"] + the ignore list (the single most likely on-card schema tweak — see quantize_m3_fp8.py). <<<
# --kv-cache-dtype turboquant_k8v4 : self-scaled fp8 KV (QUANT_CONFIG is None -> enable_fp8_attn self-scale),
#   same as the int4/fp8 M3 envs.
# TP=8 + --enable-expert-parallel : 128 experts / 8 cards. HBM: experts fp8 (~385 GiB) + bf16 rest
#   (~86 GiB) = same footprint as minimax-m3-fp8.env, so --gpu-memory-utilization 0.9 + ml 4096 hold.
# --max-num-seqs 128 : fp8's win is concurrency (the int4->bf16 per-token dequant is gone). Drop to
#   48/32 if a card OOMs at load+KV. block-size 128, async-scheduling, no prefix cache, trust-remote-code.
VLLM_ARGS="--quantization compressed-tensors --kv-cache-dtype turboquant_k8v4 --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 128 --gpu-memory-utilization 0.9 --max-model-len 4096 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
#
# ===================================================================================================
# ON-CARD VALIDATION GATE (do BEFORE trusting tok/s or deleting the int4/bf16):
#   1. Serve coherence: a few greedy prompts must produce COHERENT text (not silu salad). The route-b
#      path logs "LIVE: routed fp8 experts via UNFUSED swigluoai ... [route b ...]" and the one-shot
#      _assert_shapes orientation check refuses to serve on a bad transpose.
#   2. Router Jaccard / output A-B vs the int4 fp8-runtime baseline (minimax-m3-fp8.env): the static-fp8
#      and int4->fp8 paths run the SAME op + route-b, so outputs should match within fp8 grid noise.
#   3. Only AFTER coherence passes: delete the int4 checkpoint + the bf16 source.
# ===================================================================================================
