# MiniMax-M3 (MiniMaxM3SparseForConditionalGeneration) — 8x Gaudi 2 bring-up.
# Consumed by $HOME/AI/serve.sh (sources common.env then this file). Variable contract
# matched to glm51ar-dsa.env / glm51ar-lazy.env: MODEL_PATH, SERVED_NAME, IMAGE, MODEL_ENV
# (the "-e KEY=VAL ..." docker env string), VLLM_ARGS (the `vllm serve` flag string). serve.sh
# runs:  vllm serve /models/$MODEL_PATH --served-model-name $SERVED_NAME $VLLM_ARGS  and injects
# HPU_MOE_EXT_CKPT=/models/$MODEL_PATH + mounts hpu-moe-ext automatically (INERT here — it only
# patches int4 AutoRound MoE; this serve is FP8/INC on the bf16 checkpoint, no int4).
#
# ===================================================================================================
# PHASE 1 (this file, ENABLED): FP8 via Intel-Neural-Compressor (INC) — NATIVE fp8 experts + fp8 KV,
# DENSE-GQA fallback (MSA sparse attention OFF). Coherence/correctness first, before MSA or MTP.
#   * The model served is the ORIGINAL bf16 checkpoint; INC applies measured maxabs fp8 scales at
#     load via QUANT_CONFIG (no re-packed checkpoint). Keeps all 7 bf16 MTP modules native (no graft).
#   * MSA gate is HELD OFF (HPU_MSA_READY unset / =0). The hpu-msa-ext plugin is NOT mounted here, so
#     sparse attention cannot engage: M3's sparse layers run genuine DENSE GQA over all causal keys
#     (the FULL_ATTENTION_FALLBACK contract — never a silent empty-topk consume). Phase-1 by design.
#   * Launch:  ./serve.sh minimax-m3
# ===================================================================================================
#
# --- model location vs mount (blocker resolved via EXTRA_MOUNTS) -----------------------------------
# serve.sh mounts common.env MODELS_DIR=/mnt/fastmodels at /models:ro and serves /models/$MODEL_PATH.
# The bf16 checkpoint currently lives at /mnt/data2/minimax-m3-bf16 (NOT under /mnt/fastmodels, and
# /mnt/fastmodels/MiniMax-M3 does not exist yet). We bind the real dir in at the expected /models
# path via EXTRA_MOUNTS so MODEL_PATH resolves without moving 856GB. If/when the checkpoint is moved
# or symlinked to /mnt/fastmodels/MiniMax-M3, drop EXTRA_MOUNTS and set MODEL_PATH=MiniMax-M3.
MODEL_PATH=MiniMax-M3
EXTRA_MOUNTS="-v /mnt/data2/minimax-m3-bf16:/models/MiniMax-M3:ro"
SERVED_NAME=minimax-m3
IMAGE=vllm-gaudi:1.24
# NOTE: :1.24 is the base/pinned image (matches the INC calibrate path & common.env default). Use
# :next ONLY if a phase-2 MSA .so requires it (DSA needed :next; INC fp8 does not).
#
# --- QUANT_CONFIG (the INC master switch) ----------------------------------------------------------
# QUANT_DIR=/mnt/data1/quant (common.env) is mounted at /quant. The calibrate pass
# (quant/calibrate_m3_fp8_inc.sh --run) writes the QUANTIZE json to
#   /mnt/data1/quant/minimax-m3-fp8-inc/minimax-m3/maxabs_quant_g2.json
# => inside the container that is /quant/minimax-m3-fp8-inc/minimax-m3/maxabs_quant_g2.json.
# This file MUST exist (MEASURE->QUANTIZE done on-card) before this env will serve — it is the
# scale source INC reads at load. maxabs_hw measured ON g2 = the ±240 E4M3-fnuz grid (NEVER a g3
# measurement). See quant/calibrate_m3_fp8_inc.sh and notes/reviews/quant-quality-eval.md §3.
#
# --- env (docker -e flags) -------------------------------------------------------------------------
# PT_HPU_LAZY_MODE=1            : INC is NOT supported under torch.compile -> LAZY required.
# PT_HPU_WEIGHT_SHARING=0       : frees full-precision weights post-fp8 (avoids OOM on the big MoE).
# PT_HPU_ENABLE_LAZY_COLLECTIVES=true : the TP=8 + expert-parallel collective path under lazy.
# QUANT_CONFIG=<QUANTIZE json>  : INC master switch (mode=QUANTIZE -> applies measured fp8 scales).
# VLLM_DISABLE_MARK_SCALES_AS_CONST=true : keep INC scales as live tensors (not const-folded).
# VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 : long first-request fp8 compile must not trip the iter
#                                 timeout -> engine crash (raised from the GLM default of 1800).
# VLLM_RPC_TIMEOUT / VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS : generous, match the GLM bring-up envs.
# VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true : surface any host fallbacks during bring-up.
# HPU_MSA_READY is intentionally ABSENT (== OFF) in phase 1 -> dense-GQA fallback.
MODEL_ENV="-e PT_HPU_LAZY_MODE=1 -e PT_HPU_WEIGHT_SHARING=0 -e PT_HPU_ENABLE_LAZY_COLLECTIVES=true -e QUANT_CONFIG=/quant/minimax-m3-fp8-inc/minimax-m3/maxabs_quant_g2.json -e VLLM_DISABLE_MARK_SCALES_AS_CONST=true -e VLLM_ENGINE_ITERATION_TIMEOUT_S=3600 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
#
# --- vLLM serve flags ------------------------------------------------------------------------------
# --quantization inc + --kv-cache-dtype fp8_inc : native fp8 experts (INC) + fp8 KV cache. fp8_inc is
#   the ONLY KV dtype the HPU platform accepts.
# --tensor-parallel-size 8 --enable-expert-parallel : 128 experts across 8 cards (tp <= num_local_experts).
# --block-size 128 : HPU kernel block size (platform forces it anyway).
# --max-num-seqs 128 : concurrency. (sweep to 192 for throughput once stable; cf. qwen35-397b-tput128.env)
# --async-scheduling : V1 host-overhead lever (auto-disabled by the platform if spec-decode is on,
#   so it is mutually exclusive with the phase-2 MTP line below — fine while MTP is OFF).
# --no-enable-prefix-caching : required once MSA is on (block-select buffers assume no prefix reuse);
#   harmless in dense phase; contiguous-PA disables it anyway.
# --gpu-memory-utilization 0.9 ; --max-model-len 8192 (phase-1; full 1M needs the MSA kernel).
# --trust-remote-code : config has auto_map -> remote configuration_minimax_m3_vl class.
VLLM_ARGS="--quantization inc --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --enable-expert-parallel --block-size 128 --max-num-seqs 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code --gpu-memory-utilization 0.9 --max-model-len 8192"
#
# ===================================================================================================
# PHASE 2 (COMMENTED — enable ONLY after on-card validation; one variable at a time):
#
# (2a) MSA SPARSE ATTENTION — flip the gate ON.
#   Prereq: build task hpu-msa-ext (mirror hpu-dsa-ext; consume target is GQA HPUAttentionImpl.forward)
#   and teach serve.sh a USE_MSA mount/install hook (mirror USE_DSA). Then:
#     - add to MODEL_ENV:  -e HPU_MSA_READY=1
#     - launch with:       USE_MSA=1 ./serve.sh minimax-m3   (mounts+installs hpu-msa-ext)
#   Validate BEFORE trusting any sparse tok/s (DSA discipline): (i) indexer-fired counter > 0 on a
#   prompt with ctx > block_size*topk (=128*16=2048), (ii) ctx <= 2048 takes the dense short-circuit
#   and sparse==dense, (iii) long-prompt generations judged vs the teacher-force oracle, not vibes.
#   Then raise --max-model-len toward the 1M target. Until HPU_MSA_READY=1 AND the wire is installed,
#   the platform KEEPS RAISING for sparse layers (never serves dense in place of sparse silently) —
#   except the explicit FULL_ATTENTION_FALLBACK dense path used in phase 1.
#
# (2b) MTP / SPECULATIVE DECODE depth-1 — M3 ships 7 bf16 MTP modules (num_mtp_modules=7,
#   num_nextn_predict_layers=1), kept native under INC-fp8 (no int4 graft, unlike GLM). Proven
#   ~1.70x decode multiplier at depth-1 on this box. NOTE: mutually exclusive with --async-scheduling
#   (the platform auto-disables async under spec-decode) — REMOVE --async-scheduling from VLLM_ARGS
#   when enabling this. Append to VLLM_ARGS:
#     --speculative-config '{"method":"<M3_MTP_METHOD>","num_speculative_tokens":1}'
#   <<< M3 MTP METHOD NAME NEEDS CONFIRMATION >>> the M3 vllm plugin (minimax_m3.py) only handles the
#   load-time MTP-layer SKIP; it does NOT register a speculative method. GLM used "deepseek_mtp"
#   (its config/speculative.py:hf_config_override maps model_type -> deepseek_mtp). M3's nextn-predict
#   structure mirrors DeepSeek-MTP, so "deepseek_mtp" is the leading candidate, but confirm against
#   vllm's config/speculative.py hf_config_override + the model registry for model_type minimax_m3_vl
#   BEFORE relying on it. Keep num_speculative_tokens=1 (GLM ruled out depth-2: the single draft head
#   degrades on its own hidden).
